# Frontend API base URL for production. Leave empty for local Vite proxy usage.
# Example: https://your-backend.vercel.app
VITE_API_URL=

# Optional: override the local Vite proxy target when developing against a non-default backend.
# Example: http://localhost:4000
VITE_API_PROXY_TARGET=

# Optional local frontend port override.
VITE_PORT=5173
