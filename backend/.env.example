# Local SQLite (kept for development/demo). Keep this file for local demo work.
DATABASE_URL=file:./data/smart-hospital.db

# Production database (Turso/libSQL). Set these in Vercel only.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Server
PORT=4000
NODE_ENV=development

# Frontend origin(s) allowed by CORS. Comma-separated, no trailing slash.
# Example: FRONTEND_URL=https://smart-hospital-frontend.vercel.app
FRONTEND_URL=

# Authentication
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=12h

# Demo accounts
DEMO_PASSWORD=demo123

