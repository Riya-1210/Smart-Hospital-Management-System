{
  "services": {
    "frontend": {
      "root": ".",
      "framework": "vite"
    },
    "backend": {
  "root": "backend/",
  "framework": "express",
  "entrypoint": "dist/server.js",
  "installCommand": "npm ci",
  "buildCommand": "npm run build"
}
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
