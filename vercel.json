{
  "services": {
    "frontend": {
      "root": ".",
      "framework": "vite"
    },
   "backend": {
  "root": "backend/",
  "framework": "express",
  "entrypoint": "src/server.ts"
}
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
